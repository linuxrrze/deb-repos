# Hosted repository: indices from GitHub Pages, .deb files from cdn.zoom.us (apt >= 1.6)
deb [arch=amd64 signed-by=/etc/apt/keyrings/zoom-repo.asc] mirror+https://linuxrrze.github.io/zoom-ubuntu-repo/mirrors.txt stable main

# Self-hosted repository built with zoom-update.cron
#deb [trusted=yes] http://your-web-server.local/zoom-ubuntu-repo/ ./
