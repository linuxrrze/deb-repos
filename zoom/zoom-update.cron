#!/bin/bash

if [ "$UID" = "0" ]; then
  echo "WARNING: Running as root is not recommended!"
fi

[ -f /etc/default/zoom-update ] && . /etc/default/zoom-update

# Set base dir
ZOOM_CACHE="${ZOOM_CACHE:-${HOME}/zoom}"

ZOOM_REPO="${ZOOM_CACHE}/repo"
ZOOM_GPG_HOME="${ZOOM_CACHE}/.gnupg"
VERSION_FILE="${ZOOM_CACHE}/zoom_deb.version"

# s. https://zoom.us/download?os=linux
ZOOM_CLIENT_URL="https://zoom.us/client/latest/zoom_amd64.deb"
ZOOM_PUBKEY_URL="https://zoom.us/linux/download/pubkey"

QUIET=true

########################################################################################################################
# FUNCTIONS
########################################################################################################################

function purge()
{
  rm -rf "${ZOOM_CACHE}"
}

function init()
{
  set -e

  if [ -d "${ZOOM_CACHE}" ]; then
    ZOOM_CACHE_UID=$(stat -c "%u" "${ZOOM_CACHE}")
    if [ "$UID" != "$ZOOM_CACHE_UID" ]; then
      echo "User ID ($UID) and directory owner ($ZOOM_CACHE_UID) do not match - aborting"
      exit 1
    fi
  else
    echo -n "Initializing directories in ${ZOOM_CACHE}... "
    mkdir -p "${ZOOM_CACHE}"
    chmod 751 "${ZOOM_CACHE}"

    mkdir -p "${ZOOM_REPO}"
    chmod 755 "${ZOOM_REPO}"

    echo "zoom optional default" > "${ZOOM_CACHE}/override"
    echo "DONE"
  fi

  # ensure correct GPG home permissions to avoid warning
  if [ -d "${ZOOM_GPG_HOME}" ]; then
    find "${ZOOM_GPG_HOME}" -type f -exec chmod 600 {} \; # Set 600 for files
    find "${ZOOM_GPG_HOME}" -type d -exec chmod 700 {} \; # Set 700 for directories
  fi

  set +e
}

function update_latest_zoom_version()
{
  $QUIET || echo -n "Updating latest version... "
  if [ -f "$VERSION_FILE" ]; then
    OLD_ZOOM_VER=$(tail -n 1 "$VERSION_FILE")
  else
    OLD_ZOOM_VER="0.0"
  fi
  LATEST_ZOOM_VER=$(wget --spider "${ZOOM_CLIENT_URL}" 2>&1 | grep ^Location: | sed -e 's/.*prod\/\(.*\)\/.*/\1/')

  if [ "x$LATEST_ZOOM_VER" == "x" ]; then
    echo "ERROR: Unable to determine zoom version"
    exit 3
  elif [ ! -f "$VERSION_FILE" ] || ! grep -q "^$LATEST_ZOOM_VER\$" "$VERSION_FILE"; then
    echo "New version found: $LATEST_ZOOM_VER"
    echo "$LATEST_ZOOM_VER" >> "$VERSION_FILE"
  else
    $QUIET || echo "Version unchanged"
  fi
}

function get_pubkey()
{
  $QUIET || echo -n "Fetching new GPG key... "
  wget -q -O "${ZOOM_CACHE}/zoom.key.new" "${ZOOM_PUBKEY_URL}" 2>&1
  $QUIET || echo "DONE"

  if [ -r "${ZOOM_CACHE}/zoom.key" ]; then
    if ! cmp -s "${ZOOM_CACHE}/zoom.key.new" "${ZOOM_CACHE}/zoom.key"; then
      echo "Keys ${ZOOM_CACHE}/{zoom.key|zoom.key.new} differ - aborting"
      echo "Check keys and if valid remove old one and re-run:"
      echo "rm ${ZOOM_CACHE}/zoom.key"
      exit 1
    fi
  else
    echo "Initially importing GPG key"
    gpg --quiet --homedir "${ZOOM_GPG_HOME}" --import "${ZOOM_CACHE}/zoom.key.new"
    mv "${ZOOM_CACHE}/zoom.key.new" "${ZOOM_CACHE}/zoom.key"
  fi
}

function download_latest_zoom()
{
  $QUIET || echo -n "Checking for downloads... "
  LATEST_ZOOM_VER=$(tail -n 1 "$VERSION_FILE")
  TARGET_FILE="${ZOOM_REPO}/zoom_${LATEST_ZOOM_VER}_amd64.deb"
  if [ -f "${TARGET_FILE}" ]; then
    $QUIET || echo "Already up-to-date (${TARGET_FILE})"
    exit 1 # indicates no error - but also nothing was downloaded
  else
    echo "Found new version (${LATEST_ZOOM_VER})."
    echo -n "Downloading... "
    # Download exactly the version found above, "latest" might have moved on meanwhile
    wget --quiet -O "${ZOOM_CACHE}/download.deb" "https://cdn.zoom.us/prod/${LATEST_ZOOM_VER}/zoom_amd64.deb"
    echo "DONE"
    if ! verify_deb "${ZOOM_CACHE}/download.deb"; then
      rm -f "${ZOOM_CACHE}/download.deb"
      exit 2
    fi
    mv "${ZOOM_CACHE}/download.deb" "${TARGET_FILE}"
  fi
}

# Same check as scripts/verify-deb.sh in the repository (kept here so this
# script can be installed standalone): the .deb carries a dpkg-sig manifest
# (_gpgbuilder), a signed list of MD5/SHA1 hashes of the other archive
# members. Check the signature, then the members against the list.
function verify_deb()
{
  local deb="$1" tmp member md5 sha1 size members
  tmp=$(mktemp -d)
  if ! ar p "$deb" _gpgbuilder > "$tmp/manifest.asc" 2>/dev/null || \
     ! gpg --quiet --homedir "${ZOOM_GPG_HOME}" --trust-model always --status-fd 3 \
          --output "$tmp/manifest" --decrypt "$tmp/manifest.asc" 3> "$tmp/status" 2>/dev/null || \
     ! grep -q '^\[GNUPG:\] VALIDSIG ' "$tmp/status"; then
    echo "ERROR: signature check failed for $deb"
    rm -rf "$tmp"
    return 1
  fi
  members=$(ar t "$deb" | grep -vx _gpgbuilder)
  for member in $members; do
    md5=$(ar p "$deb" "$member" | md5sum | cut -d' ' -f1)
    sha1=$(ar p "$deb" "$member" | sha1sum | cut -d' ' -f1)
    size=$(ar p "$deb" "$member" | wc -c)
    if ! grep -qE "^[[:space:]]+${md5} ${sha1} ${size} ${member}\$" "$tmp/manifest"; then
      echo "ERROR: ${member} doesn't match the signed manifest in $deb"
      rm -rf "$tmp"
      return 1
    fi
  done
  if [ "$(grep -cE '^[[:space:]]+[0-9a-f]{32} [0-9a-f]{40} ' "$tmp/manifest")" != "$(echo "$members" | wc -l)" ]; then
    echo "ERROR: archive members don't match the signed manifest in $deb"
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$tmp"
}

function build_repo()
{
  echo "Updating repo... "
  local override="" f
  [ -f "${ZOOM_CACHE}/override" ] && override="${ZOOM_CACHE}/override"
  # Scan from inside the repo so Filename: paths are relative to it
  (cd "${ZOOM_REPO}" && dpkg-scanpackages --multiversion . ${override}) > "${ZOOM_REPO}/Packages"
  gzip -9nc "${ZOOM_REPO}/Packages" > "${ZOOM_REPO}/Packages.gz"
  {
    echo "Date: $(date -Ru)"
    echo "SHA256:"
    for f in Packages Packages.gz; do
      echo " $(sha256sum "${ZOOM_REPO}/$f" | cut -d' ' -f1) $(stat -c%s "${ZOOM_REPO}/$f") $f"
    done
  } > "${ZOOM_REPO}/Release"
  chmod 644 "${ZOOM_REPO}"/*
  echo "DONE"
}

########################################################################################################################
# DO THE THING ...
########################################################################################################################

# CAREFUL!
#purge # use to reset on every start for development

init
get_pubkey
update_latest_zoom_version
download_latest_zoom && build_repo
