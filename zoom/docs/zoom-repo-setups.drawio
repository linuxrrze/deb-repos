<mxfile host="zoom-ubuntu-repo"><diagram id="zoom-repo-setups" name="Setups"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1480" pageHeight="880" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='&lt;b style="font-size:20px"&gt;zoom (deb-repos): where the files live&lt;/b&gt;' style="text;html=1;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1460" height="40" as="geometry"/></mxCell><mxCell id="laneA" value="GitHub-hosted mode: index on GitHub, packages stay on Zoom's CDN" style="swimlane;startSize=34;html=1;fontSize=16;fontStyle=1;rounded=1;arcSize=2;align=left;spacingLeft=14;swimlaneFillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="1460" height="420" as="geometry"/></mxCell><mxCell id="laneB" value="Self-hosted mode: your server keeps a copy of every package" style="swimlane;startSize=34;html=1;fontSize=16;fontStyle=1;rounded=1;arcSize=2;align=left;spacingLeft=14;swimlaneFillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="1460" height="300" as="geometry"/></mxCell><mxCell id="a_repo" value='&lt;b style="font-size:14px"&gt;GitHub repository&lt;/b&gt;&lt;br&gt;&lt;i&gt;linuxrrze/deb-repos (main), zoom/&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;.github/workflows/update.yml&lt;br&gt;scripts/*.sh&lt;br&gt;versions.txt&lt;br&gt;versions-skipped.txt&lt;br&gt;stanzas/&amp;lt;version&amp;gt;.control&lt;br&gt;keys/zoom/*.asc&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style="color:#555555"&gt;Secret: REPO_GPG_PRIVATE_KEY&lt;/span&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneA"><mxGeometry x="20" y="54" width="280" height="180" as="geometry"/></mxCell><mxCell id="a_act" value="&lt;b style=&quot;font-size:14px&quot;&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;i&gt;every 3 hours, Ubuntu runner&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;add-new-versions.sh&lt;br&gt;make-stanza.sh&lt;br&gt;verify-deb.sh&lt;br&gt;build-index.sh&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;downloads each new .deb to a temp&lt;br&gt;dir, checks Zoom's signature and&lt;br&gt;contents, keeps only its index entry&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneA"><mxGeometry x="400" y="54" width="280" height="180" as="geometry"/></mxCell><mxCell id="a_pages" value='&lt;b style="font-size:14px"&gt;GitHub Pages&lt;/b&gt;&lt;br&gt;&lt;i&gt;linuxrrze.github.io/deb-repos/zoom/&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;mirrors.txt&lt;br&gt;zoom-repo.asc&lt;br&gt;dists/stable/InRelease&lt;br&gt;dists/stable/Release(.gpg)&lt;br&gt;dists/stable/main/binary-amd64/&lt;br&gt;&amp;#160;&amp;#160;Packages(.gz)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;span style="color:#555555"&gt;no .deb files here&lt;/span&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneA"><mxGeometry x="780" y="54" width="280" height="180" as="geometry"/></mxCell><mxCell id="a_cli" value='&lt;b style="font-size:14px"&gt;Debian/Ubuntu client&lt;/b&gt;&lt;br&gt;&lt;i&gt;apt &amp;gt;= 1.6&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;/etc/apt/sources.list.d/zoom.list&lt;br&gt;&amp;#160;&amp;#160;deb [...] mirror+https://&lt;br&gt;&amp;#160;&amp;#160;.../mirrors.txt stable main&lt;br&gt;/etc/apt/keyrings/deb-repos.asc&lt;br&gt;/var/lib/apt/lists/ (index)&lt;br&gt;/var/cache/apt/archives/&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="laneA"><mxGeometry x="1160" y="54" width="280" height="180" as="geometry"/></mxCell><mxCell id="a_third" value='&lt;b style="font-size:14px"&gt;Flathub &amp;amp; AUR&lt;/b&gt;&lt;br&gt;&lt;i&gt;git history of their Zoom packages&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;flathub/us.zoom.Zoom&lt;br&gt;aur.archlinux.org/zoom.git&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneA"><mxGeometry x="20" y="290" width="280" height="100" as="geometry"/></mxCell><mxCell id="a_cdn" value='&lt;b style="font-size:14px"&gt;Zoom&lt;/b&gt;&lt;br&gt;&lt;i&gt;the only copy of the packages&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;zoom.us/client/latest/ (302)&lt;br&gt;cdn.zoom.us/prod/&amp;lt;version&amp;gt;/&lt;br&gt;&amp;#160;&amp;#160;zoom_amd64.deb&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="laneA"><mxGeometry x="780" y="290" width="280" height="110" as="geometry"/></mxCell><mxCell id="b_zoom" value='&lt;b style="font-size:14px"&gt;Zoom&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;zoom.us/client/latest/&lt;br&gt;&amp;#160;&amp;#160;zoom_amd64.deb (302)&lt;br&gt;zoom.us/linux/download/pubkey&lt;br&gt;cdn.zoom.us/prod/&amp;lt;version&amp;gt;/&lt;br&gt;&amp;#160;&amp;#160;zoom_amd64.deb&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="laneB"><mxGeometry x="20" y="54" width="280" height="130" as="geometry"/></mxCell><mxCell id="b_srv" value='&lt;b style="font-size:14px"&gt;Your server&lt;/b&gt;&lt;br&gt;&lt;i&gt;zoom-update.cron, hourly, unprivileged user&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;/usr/local/bin/zoom-update.cron&lt;br&gt;/etc/cron.d/zoom-update&lt;br&gt;/etc/default/zoom-update (optional)&lt;br&gt;&lt;br&gt;$ZOOM_CACHE/ (default ~/zoom)&lt;br&gt;&amp;#160;&amp;#160;zoom.key, .gnupg/&lt;br&gt;&amp;#160;&amp;#160;zoom_deb.version, override&lt;br&gt;&amp;#160;&amp;#160;repo/&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;zoom_&amp;lt;version&amp;gt;_amd64.deb&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;Packages, Packages.gz, Release&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneB"><mxGeometry x="400" y="54" width="400" height="226" as="geometry"/></mxCell><mxCell id="b_web" value='&lt;b style="font-size:14px"&gt;Web server&lt;/b&gt;&lt;br&gt;&lt;i&gt;Apache, nginx, ...&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;serves $ZOOM_CACHE/repo/&lt;br&gt;as http://your-web-&lt;br&gt;&amp;#160;&amp;#160;server.local/&lt;br&gt;&amp;#160;&amp;#160;zoom-ubuntu-repo/&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneB"><mxGeometry x="860" y="54" width="220" height="130" as="geometry"/></mxCell><mxCell id="b_cli" value='&lt;b style="font-size:14px"&gt;Debian/Ubuntu client&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New"&gt;/etc/apt/sources.list.d/zoom.list&lt;br&gt;&amp;#160;&amp;#160;deb [trusted=yes]&lt;br&gt;&amp;#160;&amp;#160;http://.../ ./&lt;br&gt;/var/cache/apt/archives/&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="laneB"><mxGeometry x="1160" y="54" width="280" height="130" as="geometry"/></mxCell><mxCell id="ea1" value="checkout /&lt;br&gt;commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="laneA" source="a_repo" target="a_act"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ea2" value="deploy&lt;br&gt;(signed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="laneA" source="a_act" target="a_pages"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ea3" value="mirrors.txt&lt;br&gt;+ index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="laneA" source="a_pages" target="a_cli"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ea4" value=".deb (type:deb)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="laneA" source="a_cdn" target="a_cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="345"/></Array></mxGeometry></mxCell><mxCell id="ea5" value="latest version, .deb&lt;br&gt;(temp, verify only)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.8500;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="laneA" source="a_cdn" target="a_act"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="262"/><mxPoint x="638" y="262"/></Array></mxGeometry></mxCell><mxCell id="ea6" value="release history" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.3600;exitDx=0;exitDy=0;entryX=0.1500;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="laneA" source="a_third" target="a_act"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="442" y="326"/></Array></mxGeometry></mxCell><mxCell id="eb1" value="version,&lt;br&gt;key, .deb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2876;entryDx=0;entryDy=0;" edge="1" parent="laneB" source="b_zoom" target="b_srv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eb2" value="repo/" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.2876;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="laneB" source="b_srv" target="b_web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eb3" value="index +&lt;br&gt;.deb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="laneB" source="b_web" target="b_cli"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Arrows show where files flow. Orange: Zoom, blue: GitHub, green: your server, grey: the machine running apt." 